//tsb rolling
//Information for esp package manager
ESP_PACKAGE
{
    name = tsb
    type = Git
    description = (WIP) Compiler for the B programming language implemented by Alexey Kutepov.
    version = rolling
    cloneURL = https://github.com/tsoding/b.git
    updateURL = https://raw.githubusercontent.com/Mrcarrot1/esp/main/ExamplePackages/tsb.esp
    BUILD_COMMANDS
    [
	make -j $THREADS
    ]
    INSTALL_COMMANDS
    [
        sudo cp build/b /usr/bin/tsb
    ]
    UNINSTALL_COMMANDS
    [
        sudo rm /usr/bin/tsb
    ]
}
